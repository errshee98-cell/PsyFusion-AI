# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/psyfusion

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_me_with_a_different_64_byte_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=replace_me_with_another_random_hex_string
COOKIE_DOMAIN=localhost

# MFA challenge tokens (must be DIFFERENT from the JWT secrets above - see
# the comment in src/config/env.js for why)
MFA_CHALLENGE_SECRET=replace_me_with_yet_another_different_64_byte_random_hex_string
MFA_CHALLENGE_EXPIRES_IN=5m

# Used to build links in verification emails
FRONTEND_URL=http://localhost:5173

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Account lockout policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Crisis detection / moderation
MODERATION_REVIEW_WEBHOOK=

# ML inference service (psyfusion-ml/service) - internal network only, never
# expose this port publicly. ML_SERVICE_API_KEY must match the same
# environment variable set when starting the Python service.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=replace_me_with_a_shared_secret_matching_the_ml_service
ML_SERVICE_TIMEOUT_MS=15000
